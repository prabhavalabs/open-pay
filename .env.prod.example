# =============================================================================
# Open Lanka Payment — PRODUCTION Environment Configuration
# Copy to .env.prod on the production VPS: cp .env.prod.example .env.prod
# Branch: main  |  VPS: production droplet
# =============================================================================

# --- Security (min 32 chars, generate with: openssl rand -base64 32) ---
# MUST be a strong, unique secret. Never reuse the staging secret.
JWT_SECRET=

# --- PostgreSQL (shared platform-postgres on the external `platform` network) ---
# One non-superuser role owns every openpay database. Database names are
# DB_NAME_PREFIX + <service> + DB_NAME_SUFFIX, e.g. openpay_payment.
# The password goes into a URL for migrations, so keep it URL-safe
# (e.g. openssl rand -hex 24).
DB_HOST=platform-postgres
DB_PORT=5432
DB_USER=openpay
DB_PASSWORD=
DB_NAME_PREFIX=openpay_
DB_NAME_SUFFIX=
DB_SSLMODE=disable
# Pool size per service; 9 services x 5 stays under the role's connection limit.
DB_POOL_MAX_CONNS=5
# Docker network of the platform stack (default: platform).
PLATFORM_NETWORK=platform

# --- Gateway host bind port (loopback only; host nginx proxies to it) ---
# Keep in the 70xx range to stay clear of other projects on a shared host.
GATEWAY_BIND_PORT=7000

# --- Merchant Portal URL (production domain) ---
MERCHANT_PORTAL_URL=https://olp-merchant.nipuntheekshana.com

# --- Object storage (shared Garage S3: path-style, region "garage") ---
# A Garage key scoped to this app's bucket; not a store admin login.
# The bucket must exist and stay private (no anonymous/website access);
# files are served through the gateway at /v1/assets/<key>.
S3_ENDPOINT=http://platform-garage:3900
S3_REGION=garage
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=openpay-kyc-documents

# --- SMTP (Resend — port 2587 required on DigitalOcean, 587 is blocked) ---
SMTP_HOST=smtp.resend.com
SMTP_PORT=2587
SMTP_USERNAME=resend
SMTP_PASSWORD=
SMTP_FROM=noreply@nipuntheekshana.com

# --- Logging ---
LOG_LEVEL=info

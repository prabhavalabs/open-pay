# =============================================================================
# Open Lanka Payment — Environment Configuration
# Copy this file to .env and adjust values for your environment
# =============================================================================

# JWT Secret — MUST change in production (min 32 chars)
JWT_SECRET=dev-jwt-secret-change-in-production-min32chars

# PostgreSQL password of the bundled dev database (docker-compose.dev.yml)
POSTGRES_PASSWORD=olp_dev_password

# Database connection for host-run services (make start-native).
# Each service connects to DB_NAME_PREFIX + <service> + DB_NAME_SUFFIX,
# e.g. payment_db. DATABASE_URL, when set, overrides all of these.
# NOTE: host ports use the 70xx scheme (see docker-compose). Postgres is published on 7020.
DB_HOST=localhost
DB_PORT=7020
DB_USER=olp
DB_PASSWORD=olp_dev_password
DB_NAME_PREFIX=
DB_NAME_SUFFIX=_db
DB_SSLMODE=disable
# Optional cap on each service's connection pool (default 10).
# DB_POOL_MAX_CONNS=10

# Service Ports (host-published; containers still listen on 808x internally)
GATEWAY_PORT=7000
PAYMENT_PORT=7001
MERCHANT_PORT=7002
SETTLEMENT_PORT=7003
WEBHOOK_PORT=7004
EXCHANGE_PORT=7005
SUBSCRIPTION_PORT=7006
NOTIFICATION_PORT=7007
ADMIN_PORT=7008
DIRECTDEBIT_PORT=7009

# Service URLs (for gateway proxy and inter-service communication — native/host workflow)
MERCHANT_SERVICE_URL=http://localhost:7002
PAYMENT_SERVICE_URL=http://localhost:7001
EXCHANGE_SERVICE_URL=http://localhost:7005
SETTLEMENT_SERVICE_URL=http://localhost:7003
WEBHOOK_SERVICE_URL=http://localhost:7004
SUBSCRIPTION_SERVICE_URL=http://localhost:7006
NOTIFICATION_SERVICE_URL=http://localhost:7007
ADMIN_SERVICE_URL=http://localhost:7008
DIRECTDEBIT_SERVICE_URL=http://localhost:7009

# Object storage (S3-compatible: MinIO locally, Garage in production).
# S3_ENDPOINT takes host:port or a URL; an https:// scheme turns on TLS.
# Set S3_REGION to the store's region so the client skips region discovery.
# The bucket is private; uploads are served through the gateway at /v1/assets/.
# The older MINIO_ENDPOINT/MINIO_ACCESS_KEY/MINIO_SECRET_KEY/MINIO_BUCKET names
# are still read when the S3_* names are unset.
S3_ENDPOINT=http://localhost:7024
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin123
S3_BUCKET=kyc-documents

# SMTP — Mailpit for dev, Resend for production
# Dev (Mailpit):
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@openlankapay.dev
# Production (Resend on DigitalOcean — port 2587 required, 587 is blocked):
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=2587
# SMTP_USERNAME=resend
# SMTP_PASSWORD=re_xxxx  # your Resend API key
# SMTP_FROM=noreply@nipuntheekshana.com

# NATS
NATS_URL=nats://localhost:4222

# Redis
REDIS_URL=redis://localhost:6379

# Frontend
VITE_API_URL=http://localhost:8080

# Logging
LOG_LEVEL=info

# ─── On-chain payments (BSC testnet, chain 97) ───
# Used by the payment service's scan-and-send watcher. Leave DEPOSIT_MASTER_MNEMONIC
# empty to disable on-chain payments entirely.
SETTLEMENT_SERVICE_URL=http://localhost:7003
RPC_URL=https://bsc-testnet-rpc.publicnode.com
CHAIN_ID=97
USDC_ADDRESS=0x6c904e10631e199134891158B97311ed088A6a16
USDT_ADDRESS=0x5fB234eceBE3475E51F2A76bCE4a5d446D37CAB1
# BIP39 mnemonic the platform uses to derive per-payment deposit addresses.
# Generate a fresh one (e.g. `cast wallet new-mnemonic`) — NEVER commit a real value.
DEPOSIT_MASTER_MNEMONIC=
PAYMENT_CONFIRMATIONS=3
WATCHER_POLL_INTERVAL=15s

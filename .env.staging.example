# =============================================================================
# Open Lanka Payment — STAGING Environment Configuration
# Copy to .env.staging on the staging VPS: cp .env.staging.example .env.staging
# Branch: develop  |  VPS: staging droplet
# =============================================================================

# --- Security (min 32 chars, generate with: openssl rand -base64 32) ---
JWT_SECRET=

# --- PostgreSQL (shared platform-postgres on the external `platform` network) ---
# One non-superuser role owns every openpay database. Database names are
# DB_NAME_PREFIX + <service> + DB_NAME_SUFFIX, e.g. openpay_staging_payment.
# The password goes into a URL for migrations, so keep it URL-safe
# (e.g. openssl rand -hex 24).
DB_HOST=platform-postgres
DB_PORT=5432
DB_USER=openpay_staging
DB_PASSWORD=
DB_NAME_PREFIX=openpay_staging_
DB_NAME_SUFFIX=
DB_SSLMODE=disable
# Pool size per service; 9 services x 5 stays under the role's connection limit.
DB_POOL_MAX_CONNS=5
# Docker network of the platform stack (default: platform).
PLATFORM_NETWORK=platform

# --- Merchant Portal URL (used for payment redirect links) ---
MERCHANT_PORTAL_URL=https://staging-merchant.yourdomain.com

# --- Object storage (shared Garage S3: path-style, region "garage") ---
# A Garage key scoped to this app's bucket; not a store admin login.
# The bucket must exist and stay private (no anonymous/website access);
# files are served through the gateway at /v1/assets/<key>.
S3_ENDPOINT=http://platform-garage:3900
S3_REGION=garage
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=openpay-staging-kyc-documents

# --- SMTP (Mailpit for staging, or use Resend with staging key) ---
# Option A: Mailpit (local email testing on staging)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@staging.yourdomain.com

# Option B: Resend (real emails for staging QA)
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=2587
# SMTP_USERNAME=resend
# SMTP_PASSWORD=
# SMTP_FROM=noreply@staging.yourdomain.com

# --- Logging ---
LOG_LEVEL=debug
